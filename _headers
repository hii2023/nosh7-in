# Long-cache fingerprinted/versioned static assets (all asset URLs carry a ?v= query that is bumped on change).
# NOTE: GitHub Pages ignores this file. It applies only if served via Cloudflare Pages OR mirrored as a
# Cloudflare Cache Rule (see cloudflare-headers-setup.txt PART 4).
/assets/*
  Cache-Control: public, max-age=31536000, immutable
/js/*
  Cache-Control: public, max-age=31536000, immutable
/favicon.ico
  Cache-Control: public, max-age=604800
